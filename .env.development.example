NODE_ENV=development
PORT=3000

# With Docker: npm run docker:up then use these credentials (see docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=frontyre
DB_PASSWORD=frontyre_dev_pass
DB_NAME=frontyre_dev
DB_POOL_SIZE=10

STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads

CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000,http://127.0.0.1:3000

# Optional: protect list/read admin endpoints
ADMIN_API_KEY=dev-admin-change-me
